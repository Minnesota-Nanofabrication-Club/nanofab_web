{{- /* ============================================================
     THE SEARCH INDEX.

     Built from the same front matter the rest of the site reads, so
     it cannot drift from the content. Enabled by
     `[outputs] home = ["HTML", "JSON"]` in hugo.toml, which makes
     Hugo write this to /index.json.

     Three kinds of record:
       band     the four top-level bands
       machine  every page in content/machines/
       section  the fixed homepage anchors

     "keywords" is a flat string the browser substring-matches
     against — that is why band and process names are repeated into
     it. Searching "doping" should find the machine even though the
     word is not in its title.
   ============================================================ */ -}}
{{- $out := slice -}}

{{- /* ---------- Bands ---------- */ -}}
{{- range sort (where hugo.Data.bands "fab" true) "index" -}}
  {{- $band := . -}}
  {{- $count := len (where (where site.RegularPages "Section" "machines") "Params.band" $band.slug) -}}
  {{- $out = $out | append (dict
        "kind"     "band"
        "title"    $band.name
        "summary"  $band.tagline
        "url"      (print (relURL "") "#" $band.slug)
        "band"     $band.name
        "meta"     (printf "%d machines" $count)
        "keywords" (lower (delimit (slice $band.name $band.tagline) " "))
      ) -}}
{{- end -}}

{{- /* ---------- Machines ---------- */ -}}
{{- range where site.RegularPages "Section" "machines" -}}
  {{- $m := . -}}
  {{- $bandName := "" -}}
  {{- $processName := "" -}}
  {{- range hugo.Data.bands -}}
    {{- if eq .slug $m.Params.band -}}
      {{- $bandName = .name -}}
      {{- range (default (slice) .groups) -}}
        {{- if eq .slug $m.Params.process -}}{{- $processName = .name -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $status := default "planned" $m.Params.status -}}
  {{- $out = $out | append (dict
        "kind"     "machine"
        "title"    $m.Title
        "summary"  (default "" $m.Params.summary)
        "url"      $m.RelPermalink
        "band"     $bandName
        "meta"     (cond (ne $processName "") $processName (default "" $m.Params.step))
        "status"   $status
        "keywords" (lower (delimit (slice $m.Title (default "" $m.Params.summary) $bandName $processName (default "" $m.Params.step) $status) " "))
      ) -}}
{{- end -}}

{{- /* ---------- Fixed homepage sections ---------- */ -}}
{{- $sections := slice
      (dict "title" "Team"      "url" (print (relURL "") "#team")      "summary" "Everyone building the fab.")
      (dict "title" "Advisors"  "url" (print (relURL "") "#advisors")  "summary" "Faculty advisors and graduate mentors.")
      (dict "title" "Sponsors"  "url" (print (relURL "") "#sponsors")  "summary" "The companies backing the build.")
-}}
{{- range $sections -}}
  {{- $out = $out | append (dict
        "kind"     "section"
        "title"    .title
        "summary"  .summary
        "url"      .url
        "band"     ""
        "meta"     "Page section"
        "keywords" (lower (print .title " " .summary))
      ) -}}
{{- end -}}

{{- dict "records" $out | jsonify -}}
